+std::vector<uint8_t> Session::ExportSecret(std::string const& label,
+                                           std::vector<uint8_t> const& context,
+                                           size_t size) const noexcept
+try {
+    if (!currentState_ || label.empty() || label == USER_MEDIA_KEY_BASE_LABEL || size == 0) {
+        return {};
+    }
+
+    return std::move(currentState_->do_export(label, context, size).as_vec());
+}
+catch (const std::exception& e) {
+    DISCORD_LOG(LS_ERROR) << "Failed to export secret: " << e.what();
+    return {};
+}
