+// Exo's call relay keys: every member of an epoch exports the same secret, a
+// non-member and the next epoch get another, and labels keep secrets apart.
+TEST_F(MlsSessionTests, SessionExportSecretIsSharedPerEpoch)
+{
+    const std::string label = "Exo call relay v1";
+    ExternalSender externalSender(kTestProtocolVersion, kTestGroupId);
+    TestSession a(kUserA);
+    TestSession b(kUserB);
+    TestSession c(kUserC);
+    a.InitAndSetExternalSender(externalSender, kTestGroupId);
+    b.InitAndSetExternalSender(externalSender, kTestGroupId);
+    c.InitAndSetExternalSender(externalSender, kTestGroupId);
+
+    EXPECT_TRUE(a.session->ExportSecret(label, {}, 32).empty());
+
+    auto first = ProposeAddAndCommit(externalSender, a, b);
+    ASSERT_TRUE(first.has_value());
+    auto firstRoster = a.session->ProcessCommit(first->commit);
+    ASSERT_NE(std::get_if<RosterMap>(&firstRoster), nullptr);
+    ASSERT_TRUE(b.session->ProcessWelcome(first->welcome, {kUserA, kUserB}).has_value());
+
+    auto epochOneA = a.session->ExportSecret(label, {}, 32);
+    auto epochOneB = b.session->ExportSecret(label, {}, 32);
+    ASSERT_EQ(epochOneA.size(), 32u);
+    EXPECT_EQ(epochOneA, epochOneB);
+    EXPECT_TRUE(c.session->ExportSecret(label, {}, 32).empty());
+    EXPECT_NE(a.session->ExportSecret("Another label", {}, 32), epochOneA);
+    EXPECT_NE(a.session->ExportSecret(label, {1}, 32), epochOneA);
+    EXPECT_NE(epochOneA, a.session->GetLastEpochAuthenticator());
+    EXPECT_TRUE(a.session->ExportSecret("Discord Secure Frames v0", {}, 32).empty());
+
+    // c joins: everyone moves to epoch 2 and a new secret
+    auto proposal = externalSender.ProposeAdd(1, c.session->GetMarshalledKeyPackage());
+    auto commitWelcome = a.session->ProcessProposals(proposal, {kUserA, kUserB, kUserC});
+    ASSERT_TRUE(commitWelcome.has_value());
+    b.session->ProcessProposals(proposal, {kUserA, kUserB, kUserC});
+    auto [commit, welcome] = externalSender.SplitCommitWelcome(*commitWelcome);
+    auto rosterA = a.session->ProcessCommit(commit);
+    auto rosterB = b.session->ProcessCommit(commit);
+    ASSERT_NE(std::get_if<RosterMap>(&rosterA), nullptr);
+    ASSERT_NE(std::get_if<RosterMap>(&rosterB), nullptr);
+    ASSERT_TRUE(c.session->ProcessWelcome(welcome, {kUserA, kUserB, kUserC}).has_value());
+
+    auto epochTwoA = a.session->ExportSecret(label, {}, 32);
+    EXPECT_EQ(epochTwoA, b.session->ExportSecret(label, {}, 32));
+    EXPECT_EQ(epochTwoA, c.session->ExportSecret(label, {}, 32));
+    EXPECT_NE(epochTwoA, epochOneA);
+}
