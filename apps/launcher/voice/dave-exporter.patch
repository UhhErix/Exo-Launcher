+void daveSessionExportSecret(DAVESessionHandle sessionHandle,
+                             const char* label,
+                             const uint8_t* context,
+                             size_t contextLength,
+                             size_t size,
+                             uint8_t** secret,
+                             size_t* length)
+{
+    ARG_CHECK(sessionHandle);
+    ARG_CHECK(label);
+    auto session = reinterpret_cast<discord::dave::mls::ISession*>(sessionHandle);
+    std::vector<uint8_t> exported;
+    if (context != nullptr || contextLength == 0) {
+        auto contextVec = context ? std::vector<uint8_t>(context, context + contextLength)
+                                  : std::vector<uint8_t>();
+        exported = session->ExportSecret(label, contextVec, size);
+    }
+    CopyVectorToOutputBuffer(exported, secret, length);
+}
