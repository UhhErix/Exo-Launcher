<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exo Shaders engine service: hosts one ScsKiller (SCSKiller.Core) headlessly and speaks NDJSON over stdin/stdout.
       See CONTRACT.md. GPL-3.0-or-later with the SCSKiller additional permission (LICENSE, LICENSE-EXCEPTION.txt). -->
  <ItemGroup>
    <!-- ExoBuild: the Core compiles as the Exo build (local-only, App/ExoBuild.cs, EXO_BUILD) -->
    <ProjectReference Include="..\..\..\src\SCSKiller.Core\SCSKiller.Core.csproj" AdditionalProperties="ExoBuild=true" />
    <ProjectReference Include="..\..\..\src\SCSKiller.Cli\SCSKiller.Cli.csproj" AdditionalProperties="ExoBuild=true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ExoShaders.Service</AssemblyName>
    <RootNamespace>ExoShaders.Service</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <MetricsSupport>false</MetricsSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- No window waits on a collection: blocking gen 2 collections, no background GC thread. Measured on a page visit
         (scan of 23 games): 142 MB peak private memory instead of 186 MB, the same CPU time. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- AppVersion.Current (the engine's version, its update channel and the news/rules channels it reads) comes from
         the entry assembly, so the service reports the engine version it hosts. The service's own version is
         ServiceVersion in Program.cs. -->
    <Product>Exo Shaders</Product>
    <Company>Exo Shaders (unofficial fork of SCSKiller)</Company>
    <Authors>The SCSKiller authors; Exo Shaders contributors</Authors>
    <Copyright>Copyright (C) 2026 The SCSKiller authors</Copyright>
    <Version>1.4.8-exo.1</Version>
    <InformationalVersion>1.4.8-exo.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="scskiller" />
    <TrimmableAssembly Include="BouncyCastle.Cryptography" />
    <TrimmableAssembly Include="CUE4Parse" />
    <TrimmableAssembly Include="OggVorbisEncoder" />
    <TrimmableAssembly Include="Fmod5Sharp" />
    <TrimmableAssembly Include="VGAudio" />
    <TrimmableAssembly Include="NAudio.Core" />
    <TrimmableAssembly Include="Velopack" />
    <TrimmableAssembly Include="Serilog" />
    <TrimmableAssembly Include="MemoryPack.Core" />
    <TrimmableAssembly Include="FixedMathSharp" />
    <TrimmableAssembly Include="UE4Config" />
    <TrimmableAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

  <Target Name="TrimUnusedPublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_UnusedPublishFiles Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll' or '%(Filename)%(Extension)' == 'mscordaccore.dll' or $([System.String]::Copy('%(Filename)%(Extension)').StartsWith('mscordaccore_', System.StringComparison.OrdinalIgnoreCase)) or '%(Filename)%(Extension)' == 'mscordbi.dll' or '%(Filename)%(Extension)' == 'createdump.exe'" />
      <ResolvedFileToPublish Remove="@(_UnusedPublishFiles)" />
    </ItemGroup>
  </Target>

</Project>
