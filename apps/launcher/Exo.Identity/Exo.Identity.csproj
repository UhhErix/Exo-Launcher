<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Exo's identity (plan §2): the device keys in CNG (TPM first), the device list, linking a PC, the recovery code, the
    envelope, sync batches and the mailbox frames. No UI, no network of its own and no app's data folder;
    Vectors/exo-identity-vectors.json holds its bytes in place, so what is already synced stays readable.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Every app builds this with Native AOT: anything that needs reflection or code at run time stops the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Exo.Identity</AssemblyName>
    <DefineConstants>$(DefineConstants);EXO_IDENTITY_LINKED</DefineConstants>
    <RootNamespace>Exo.Identity</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ExoLauncher" />
    <InternalsVisibleTo Include="ExoLauncher.Tests" />
    <None Include="Vectors\exo-identity-vectors.json" />
    <!-- The deletion gate is shared source: every Exo.Identity delete goes through it (BannedSymbols.txt). -->
    <Compile Include="..\ExoLauncher\Helpers\DeletionGate.cs" Link="Shared\DeletionGate.cs" />
    <Compile Include="..\ExoLauncher\Helpers\DeletionProtections.cs" Link="Shared\DeletionProtections.cs" />
    <Compile Include="..\ExoLauncher\Helpers\FinalPath.cs" Link="Shared\FinalPath.cs" />
    <Using Include="ExoLauncher.Helpers.Linked" />
  </ItemGroup>
</Project>
