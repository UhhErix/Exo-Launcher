<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds a release's files.json and files.pack (Build-Release.ps1), and measures what an update from an installed
       folder would download. The format is ExoLauncher's own Services/AppFiles.cs, compiled in here unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExoLauncher.Tools</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ExoLauncher\Services\AppFiles.cs" Link="AppFiles.cs" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
