{
  "name": "exo-mouse",
  "private": true,
  "version": "0.1.0",
  "description": "Exo Mouse: the Devices room's mouse settings, built on OpenMouse's protocol library.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-protocol.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src && eslint src --max-warnings 0",
    "check": "node scripts/build-protocol.mjs && npm run -s typecheck && npm run -s lint && node scripts/css-design.mjs && node --test test/*.test.ts",
    "test": "node --test test/*.test.ts",
    "postinstall": "node scripts/build-protocol.mjs"
  },
  "dependencies": {
    "@openmouse/protocol": "file:vendor/openmouse-protocol",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.1.0-dev.20261121.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-oxlint": "1.94.0",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
