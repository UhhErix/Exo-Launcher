<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>ExoLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Exo carries the Windows App SDK itself, so no PC needs its runtime installed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <!-- Keep private source metadata in local build symbols, outside release downloads. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Trim only what is marked trimmable: the runtime and the Windows, WinUI and WebView2
         projections (Microsoft.Windows.SDK.NET alone shipped 60 MB). Exo's own assembly stays
         whole, so its reflection JSON (anonymous RPC replies) and [ComImport] interop keep
         working; Native AOT can express neither. The analyzers would only repeat that. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <MetricsSupport>false</MetricsSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <!-- No instrumented JIT tier: less JIT work at start and while idle. -->
    <TieredPGO>false</TieredPGO>
    <ApplicationIcon Condition="Exists('Assets\ExoLauncher.ico')">Assets\ExoLauncher.ico</ApplicationIcon>
    <AssemblyName>ExoLauncher</AssemblyName>
    <Product>Exo Launcher</Product>
    <AssemblyTitle>Exo Launcher</AssemblyTitle>
    <Company>Exo</Company>
    <Copyright>Copyright (c) 2026 Erix (UhhErix)</Copyright>
    <Description>One calm Windows library UI. Other store clients become invisible backends.</Description>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <InternalsVisibleTo Include="ExoLauncher.Tests" />
    <AssemblyMetadata Include="EXO_OAUTH_SPOTIFY_CLIENT_ID" Value="$(EXO_OAUTH_SPOTIFY_CLIENT_ID)" Condition="'$(EXO_OAUTH_SPOTIFY_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_DISCORD_CLIENT_ID" Value="$(EXO_OAUTH_DISCORD_CLIENT_ID)" Condition="'$(EXO_OAUTH_DISCORD_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_GOOGLE_CLIENT_ID" Value="$(EXO_OAUTH_GOOGLE_CLIENT_ID)" Condition="'$(EXO_OAUTH_GOOGLE_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_TWITCH_CLIENT_ID" Value="$(EXO_OAUTH_TWITCH_CLIENT_ID)" Condition="'$(EXO_OAUTH_TWITCH_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_BATTLENET_CLIENT_ID" Value="$(EXO_OAUTH_BATTLENET_CLIENT_ID)" Condition="'$(EXO_OAUTH_BATTLENET_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_MICROSOFT_CLIENT_ID" Value="$(EXO_OAUTH_MICROSOFT_CLIENT_ID)" Condition="'$(EXO_OAUTH_MICROSOFT_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_RIOT_CLIENT_ID" Value="$(EXO_OAUTH_RIOT_CLIENT_ID)" Condition="'$(EXO_OAUTH_RIOT_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="EXO_OAUTH_EPIC_CLIENT_ID" Value="$(EXO_OAUTH_EPIC_CLIENT_ID)" Condition="'$(EXO_OAUTH_EPIC_CLIENT_ID)' != ''" />
  </ItemGroup>



  <ItemGroup>
    <!-- Reference only the WinUI components used by the active host. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261119100">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- File-level updates: each file of files.pack is a zstd frame (Services/AppFiles.cs). MIT. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageDownload Include="Microsoft.ML.OnnxRuntime" Version="[1.31.1]" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The driver advisories built in: the same bytes cloud/updates/advisories.mjs signs as Exo's feed (DriverAdvisories.cs). -->
    <EmbeddedResource Include="Services\DriverAdvisories.json" LogicalName="DriverAdvisories.json" />
    <EmbeddedResource Include="Services\StartupCatalog.json" LogicalName="StartupCatalog.json" />
    <!-- The file-level update's swap (AppUpdateService.Delta): the installer's own scripts, run after Exo closes. -->
    <EmbeddedResource Include="..\tools\installer\Apply-ExoDelta.ps1;..\tools\installer\Complete-ExoUpdate.ps1;..\tools\installer\Verify-Payload.ps1;..\tools\installer\Close-ExoLauncher.ps1;..\tools\installer\Clean-ExoInstall.ps1" LogicalName="installer/%(Filename)%(Extension)" Link="Installer\%(Filename)%(Extension)" />
    <!-- Geist beside the app: the banner's WOFF2 the UI ships, and for GDI and DirectWrite the TTF native-ui embeds; one copy of each in the repo. -->
    <Content Include="..\ui\public\fonts\Geist-Variable.woff2" Link="Assets\Overlay\Geist-Variable.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\native-ui\crates\exo-kit\assets\fonts\Geist-Variable.ttf;..\native-ui\crates\exo-kit\assets\fonts\LICENSE-Geist.txt" Link="Assets\Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\**\*">
      <!-- Asset archives can retain upstream timestamps. Always copy them so a
           rebuilt app never ships an older cue merely because its source date
           predates a previous publish. -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\VERSION" Link="VERSION" Condition="Exists('..\VERSION')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

  </ItemGroup>



  <Target Name="BuildWebUi" Condition="Exists('$(MSBuildThisFileDirectory)..\ui\package.json')">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\ui\node_modules')" Text="ui/node_modules is missing. Run: cd ui &amp;&amp; npm ci. Refusing to package stale generated web assets." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\mouse\node_modules')" Text="mouse/node_modules is missing. Run: cd mouse &amp;&amp; npm ci. Exo Mouse builds with the web UI." />
    <Exec Command="node scripts/build-cache.mjs" WorkingDirectory="$(MSBuildThisFileDirectory)..\ui" IgnoreExitCode="false" />
  </Target>

  <!--
    Vite emits content-hashed filenames and clears the output directory, so a
    wwwroot glob evaluated at project load names the *previous* build's assets
    and the copy step fails with MSB3030. Collect it after the UI build instead.
  -->
  <Target Name="CollectWebUi" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebUi">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot\index.html')" Text="ExoLauncher/wwwroot/index.html missing. Run: cd ui &amp;&amp; npm ci &amp;&amp; npm run build" />
    <ItemGroup>
      <Content Include="wwwroot\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup>
    <_SteamIpcPub>$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\bin\x64\$(Configuration)\native-publish\</_SteamIpcPub>
  </PropertyGroup>
  <ItemGroup>
    <_SteamIpcInputs Include="$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\*.cs;$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\*.csproj;$(MSBuildThisFileDirectory)Adapters\SteamIpcStubResolver.cs;$(MSBuildThisFileDirectory)Adapters\SteamProgressCounters.cs;$(MSBuildThisFileDirectory)Adapters\SteamStateFlags.cs;$(MSBuildThisFileDirectory)..\Directory.Build.props;$(MSBuildThisFileDirectory)..\global.json;$(MSBuildThisFileDirectory)..\VERSION;$(MSBuildThisFileFullPath)" />
  </ItemGroup>
  <Target Name="PrepareSteamIpc" Inputs="@(_SteamIpcInputs)" Outputs="$(_SteamIpcPub)ExoLauncher.SteamIpc.exe" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- A fresh helper must be evaluated again after restore so its NativeAOT
         package targets are imported. Restore;Publish in one MSBuild instance
         misses those imports when obj was cleaned. dotnet publish handles this. NativeAOT's linker step runs
         Visual Studio's scripts, which call vswhere.exe by name: its folder is put on PATH for it. -->
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\ExoLauncher.SteamIpc.csproj&quot; -c $(Configuration) -r win-x64 -p:Platform=x64 --self-contained true -p:PublishAot=true --output &quot;$(_SteamIpcPub).&quot;"
          EnvironmentVariables="PATH=$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer%3B$([MSBuild]::Escape($(PATH)))" />
  </Target>
  <Target Name="BuildSteamIpc" AfterTargets="Build" DependsOnTargets="PrepareSteamIpc" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(OutDir)steam-ipc" />
    <Copy SourceFiles="$(_SteamIpcPub)ExoLauncher.SteamIpc.exe" DestinationFolder="$(OutDir)steam-ipc" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishSteamIpc" AfterTargets="Publish" DependsOnTargets="PrepareSteamIpc" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(PublishDir)steam-ipc" />
    <Copy SourceFiles="$(_SteamIpcPub)ExoLauncher.SteamIpc.exe" DestinationFolder="$(PublishDir)steam-ipc" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <_OnnxRuntime>$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.31.1\runtimes\win-x64\native\onnxruntime.dll</_OnnxRuntime>
  </PropertyGroup>
  <Target Name="BuildOnnxRuntime" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(_OnnxRuntime)')" Text="ONNX Runtime 1.31.1 is missing from the NuGet cache. Run: dotnet restore" />
    <Copy SourceFiles="$(_OnnxRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishOnnxRuntime" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(_OnnxRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="TrimUnusedPublishFiles" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_UnusedLocaleMui Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)en-US\*.mui;$(PublishDir)en-us\*.mui" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll;$(PublishDir)mscordaccore*.dll;$(PublishDir)mscordbi.dll;$(PublishDir)createdump.exe;$(PublishDir)DWriteCore.dll;$(PublishDir)WinUIEdit.dll;$(PublishDir)Microsoft.UI.Xaml.winmd;$(PublishDir)Microsoft.UI.winmd;$(PublishDir)Microsoft.UI.Designer.dll;$(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll" />
      <_UnusedLegacyWebUi Include="$(PublishDir)wwwroot\**\*" Exclude="$(PublishDir)wwwroot\mouse\**\*;$(PublishDir)wwwroot\pay\**\*;$(PublishDir)wwwroot\changelog.gz" Condition="Exists('$(PublishDir)exo-ui.exe')" />
    </ItemGroup>
    <Delete Files="@(_UnusedLocaleMui);@(_UnusedPublishFiles);@(_UnusedLegacyWebUi)" />
    <RemoveDir Directories="@(_UnusedLocaleMui->'%(RootDir)%(Directory)')" />
    <RemoveDir Directories="$(PublishDir)wwwroot\assets;$(PublishDir)wwwroot\fonts;$(PublishDir)wwwroot\.vite;$(PublishDir)wwwroot\icons" Condition="Exists('$(PublishDir)exo-ui.exe')" />
  </Target>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\capture\out\ExoCapture.exe')">
    <_ExoCaptureFiles Include="$(MSBuildThisFileDirectory)..\capture\out\ExoCapture.exe" />
    <_ExoCaptureObsFiles Include="$(MSBuildThisFileDirectory)..\capture\out\obs\**\*.*" />
  </ItemGroup>
  <Target Name="CopyExoCapture" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\capture\out\ExoCapture.exe')">
    <MakeDir Directories="$(OutDir)addons\capture" />
    <Copy SourceFiles="@(_ExoCaptureFiles)" DestinationFolder="$(OutDir)addons\capture" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ExoCaptureObsFiles)" DestinationFiles="@(_ExoCaptureObsFiles->'$(OutDir)addons\capture\obs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishExoCapture" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\capture\out\ExoCapture.exe')">
    <MakeDir Directories="$(PublishDir)addons\capture" />
    <Copy SourceFiles="@(_ExoCaptureFiles)" DestinationFolder="$(PublishDir)addons\capture" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ExoCaptureObsFiles)" DestinationFiles="@(_ExoCaptureObsFiles->'$(PublishDir)addons\capture\obs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Discord voice: libdave (DAVE end-to-end encryption), libopus and exo_apm (WebRTC's echo cancellation), built by voice\build.ps1.
         Each is copied once it is built: CI builds and tests without them (their tests skip), and tools\Build-Release.ps1
         builds them first and refuses a release whose app folder lacks any. -->
    <Content Include="..\voice\out\dave.dll" Condition="Exists('..\voice\out\dave.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\voice\out\opus.dll" Condition="Exists('..\voice\out\opus.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\voice\out\exo_apm.dll" Condition="Exists('..\voice\out\exo_apm.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- DeepFilterNet noise suppression (Exo's build of its C interface, voice\build.ps1): ships in the app, so a call has it from the first join. -->
    <Content Include="..\voice\out\exo-deepfilter.dll" Condition="Exists('..\voice\out\exo-deepfilter.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\native-ui\target\release-cdylib\exo_voice_ml.dll" Condition="Exists('..\native-ui\target\release-cdylib\exo_voice_ml.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\native-ui\target\release-cdylib\exo_apo.dll" Condition="Exists('..\native-ui\target\release-cdylib\exo_apo.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\native-ui\target\release\exo-apo-helper.exe" Condition="Exists('..\native-ui\target\release\exo-apo-helper.exe')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\voice\out\LICENSE-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\voice\licenses\LICENSE-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\native-ui\target\release\exo-ui.exe" Condition="Exists('..\native-ui\target\release\exo-ui.exe')" Link="exo-ui.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every host delete goes through the deletion gate (BannedSymbols.txt bans the raw File/Directory deletes). -->
    <Using Include="ExoLauncher.Helpers" />
  </ItemGroup>
</Project>
