{
  "gates": [
    { "name": "ui", "cwd": "ui", "cmd": "npm run -s check && npm run -s dead && npm run -s build" },
    { "name": "host", "cmd": "dotnet build ExoLauncher.Tests/ExoLauncher.Tests.csproj -c Release -p:Platform=x64 -m:1 -clp:ErrorsOnly" },
    { "name": "test", "cmd": "dotnet test --project ExoLauncher.Tests -c Release -p:Platform=x64 --no-build" },
    { "name": "tools", "cmd": "node --test tools/exo.test.mjs tools/e2e/lib/affected.test.mjs" }
  ]
}
